// PerVertexKHR corners of a mesh pipeline: Locations 0 and 3 are copied, Location 2 stays interpolated.
// MATRIX and LINES are the forms the corner copies refuse.
#extension GL_EXT_mesh_shader : require
layout(local_size_x = 3) in;
#ifdef LINES
layout(lines, max_vertices = 3, max_primitives = 1) out;
#else
layout(triangles, max_vertices = 3, max_primitives = 1) out;
#endif
#ifdef MATRIX
layout(location = 0) out mat2 corner[];
#else
layout(location = 0) out vec4 corner[];
#endif
layout(location = 2) out vec4 interpolated[];
layout(location = 3, component = 1) out vec2 packed[];

void main()
{
	uint i = gl_LocalInvocationIndex;
	SetMeshOutputsEXT(3, 1);
	gl_MeshVerticesEXT[i].gl_Position = vec4(float(i), 0.0, 0.0, 1.0);
#ifdef MATRIX
	corner[i] = mat2(float(i));
#else
	corner[i] = vec4(float(i));
#endif
	interpolated[i] = vec4(1.0);
	packed[i] = vec2(float(i), 2.0);
#ifdef LINES
	if (i == 0u)
		gl_PrimitiveLineIndicesEXT[0] = uvec2(0u, 1u);
#else
	if (i == 0u)
		gl_PrimitiveTriangleIndicesEXT[0] = uvec3(2u, 0u, 1u);
#endif
}
