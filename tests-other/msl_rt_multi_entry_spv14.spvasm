OpCapability RayTracingKHR
OpExtension "SPV_KHR_ray_tracing"
OpMemoryModel Logical GLSL450
OpEntryPoint AnyHitKHR %main_a "a" %payload_a
OpEntryPoint AnyHitKHR %main_b "b" %payload_b
%void = OpTypeVoid
%fn = OpTypeFunction %void
%float = OpTypeFloat 32
%v4float = OpTypeVector %float 4
%ptr_in_float = OpTypePointer IncomingRayPayloadKHR %float
%ptr_in_v4float = OpTypePointer IncomingRayPayloadKHR %v4float
%payload_a = OpVariable %ptr_in_float IncomingRayPayloadKHR
%payload_b = OpVariable %ptr_in_v4float IncomingRayPayloadKHR
%main_a = OpFunction %void None %fn
%entry_a = OpLabel
%value_a = OpLoad %float %payload_a
OpReturn
OpFunctionEnd
%main_b = OpFunction %void None %fn
%entry_b = OpLabel
%value_b = OpLoad %v4float %payload_b
OpReturn
OpFunctionEnd
