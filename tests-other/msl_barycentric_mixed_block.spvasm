; Legal member-decorated builtins, default loads and explicit interpolation in a helper.
OpCapability Shader
OpCapability SampleRateShading
OpCapability FragmentBarycentricKHR
OpCapability InterpolationFunction
OpExtension "SPV_KHR_fragment_shader_barycentric"
%glsl = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %main "main" %weights %color
OpEntryPoint Fragment %loads "loads" %weights %color
OpEntryPoint Fragment %frag_loads "frag_loads" %weights %color
OpExecutionMode %main OriginUpperLeft
OpExecutionMode %loads OriginUpperLeft
OpExecutionMode %frag_loads OriginUpperLeft
OpDecorate %block Block
OpMemberDecorate %block 0 BuiltIn BaryCoordKHR
OpMemberDecorate %block 1 BuiltIn BaryCoordNoPerspKHR
OpMemberDecorate %block 2 BuiltIn FragCoord
OpDecorate %color Location 0
%void = OpTypeVoid
%float = OpTypeFloat 32
%uint = OpTypeInt 32 0
%vec3 = OpTypeVector %float 3
%vec4 = OpTypeVector %float 4
%in4 = OpTypePointer Input %vec4
%block = OpTypeStruct %vec3 %vec3 %vec4
%inblock = OpTypePointer Input %block
%in3 = OpTypePointer Input %vec3
%out3 = OpTypePointer Output %vec3
%void_fn = OpTypeFunction %void
%vec_fn = OpTypeFunction %vec3
%zero = OpConstant %uint 0
%one = OpConstant %uint 1
%two = OpConstant %uint 2
%weights = OpVariable %inblock Input
%color = OpVariable %out3 Output
%helper = OpFunction %vec3 None %vec_fn
%h = OpLabel
%pp = OpAccessChain %in3 %weights %zero
%np = OpAccessChain %in3 %weights %one
%p = OpExtInst %vec3 %glsl InterpolateAtCentroid %pp
%n = OpExtInst %vec3 %glsl InterpolateAtSample %np %one
%sum = OpFAdd %vec3 %p %n
OpReturnValue %sum
OpFunctionEnd
; Mixed block without any explicit interpolation; FragCoord still follows the native path.
%frag_loads = OpFunction %void None %void_fn
%fl = OpLabel
%flv = OpFunctionCall %vec3 %load_helper
%flp = OpAccessChain %in4 %weights %two
%flc = OpLoad %vec4 %flp
%flxyz = OpVectorShuffle %vec3 %flc %flc 0 1 2
%flr = OpFAdd %vec3 %flv %flxyz
OpStore %color %flr
OpReturn
OpFunctionEnd
%load_helper = OpFunction %vec3 None %vec_fn
%lh = OpLabel
%lp = OpAccessChain %in3 %weights %zero
%ln = OpAccessChain %in3 %weights %one
%lv0 = OpLoad %vec3 %lp
%lv1 = OpLoad %vec3 %ln
%lv = OpFAdd %vec3 %lv0 %lv1
OpReturnValue %lv
OpFunctionEnd
%loads = OpFunction %void None %void_fn
%le = OpLabel
%loaded = OpFunctionCall %vec3 %load_helper
OpStore %color %loaded
OpReturn
OpFunctionEnd
%main = OpFunction %void None %void_fn
%m = OpLabel
%result = OpFunctionCall %vec3 %helper
%pdefault = OpAccessChain %in3 %weights %zero
%ndefault = OpAccessChain %in3 %weights %one
%pd = OpLoad %vec3 %pdefault
%nd = OpLoad %vec3 %ndefault
%defaults = OpFAdd %vec3 %pd %nd
%final = OpFAdd %vec3 %result %defaults
%fp = OpAccessChain %in4 %weights %two
%fc = OpLoad %vec4 %fp
%xyz = OpVectorShuffle %vec3 %fc %fc 0 1 2
%withfc = OpFAdd %vec3 %final %xyz
OpStore %color %withfc
OpReturn
OpFunctionEnd
