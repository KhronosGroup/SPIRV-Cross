#version 450
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 1) in;
layout(triangles, max_vertices = 3, max_primitives = 1) out;

struct S
{
	uvec4 v[2];
	vec4 w;
};

layout(location = 0) perprimitiveEXT flat out S ls[];
layout(location = 3) out vec4 arr[][2];

void main()
{
	SetMeshOutputsEXT(3, 1);
	gl_MeshVerticesEXT[0].gl_Position = vec4(0.0);
	gl_MeshVerticesEXT[1].gl_Position = vec4(1.0);
	gl_MeshVerticesEXT[2].gl_Position = vec4(2.0);
	for (int i = 0; i < 3; i++) { arr[i][0] = vec4(i); arr[i][1] = vec4(i + 1); }
	gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
	ls[0].v[0] = uvec4(1u);
	ls[0].v[1] = uvec4(2u);
	ls[0].w = vec4(3.0);
}
