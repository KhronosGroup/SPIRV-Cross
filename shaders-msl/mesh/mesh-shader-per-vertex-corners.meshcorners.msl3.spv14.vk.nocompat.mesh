// PerVertexKHR corners (Locations 0 and 3) of a mesh pipeline: three per-primitive copies in index order.
#extension GL_EXT_mesh_shader : require
layout(local_size_x = 3) in;
layout(triangles, max_vertices = 3, max_primitives = 1) out;
layout(location = 0) out vec4 corner[];
layout(location = 2) out vec4 interpolated[];
layout(location = 3, component = 1) out vec2 packed[];

void main()
{
	uint i = gl_LocalInvocationIndex;
	SetMeshOutputsEXT(3, 1);
	gl_MeshVerticesEXT[i].gl_Position = vec4(float(i), 0.0, 0.0, 1.0);
	corner[i] = vec4(float(i));
	interpolated[i] = vec4(1.0);
	packed[i] = vec2(float(i), 2.0);
	if (i == 0u)
		gl_PrimitiveTriangleIndicesEXT[0] = uvec3(2u, 0u, 1u);
}
