#version 450
layout(local_size_x = 64) in;

// Two views of one storage buffer at binding 0.
layout(std430, set = 0, binding = 0) readonly buffer X { float x[]; };
layout(std430, set = 0, binding = 0) readonly buffer X4 { vec4 x4[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Y { float y[]; };

void main()
{
	uint i = gl_GlobalInvocationID.x;
	y[i] = x[i] + x4[i >> 2u][i & 3u];
}
