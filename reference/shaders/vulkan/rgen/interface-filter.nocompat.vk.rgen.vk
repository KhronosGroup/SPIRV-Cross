#version 460
#extension GL_NV_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureNV scene;
layout(location = 0) rayPayloadNV vec4 payload;
layout(location = 1) rayPayloadNV vec4 unusedPayload;
layout(location = 2) callableDataNV float callable;
layout(location = 3) callableDataNV float unusedCallable;

void main()
{
    traceNV(scene, 0u, 255u, 0u, 0u, 0u, vec3(0.0), 0.0, vec3(0.0, 0.0, 1.0), 1.0, 0);
    executeCallableNV(0u, 2);
}

