#pragma clang diagnostic ignored "-Wmissing-prototypes"
#pragma clang diagnostic ignored "-Wmissing-braces"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

template<typename T, size_t Num>
struct spvUnsafeArray
{
    T elements[Num ? Num : 1];
    
    thread T& operator [] (size_t pos) thread
    {
        return elements[pos];
    }
    constexpr const thread T& operator [] (size_t pos) const thread
    {
        return elements[pos];
    }
    
    device T& operator [] (size_t pos) device
    {
        return elements[pos];
    }
    constexpr const device T& operator [] (size_t pos) const device
    {
        return elements[pos];
    }
    
    constexpr const constant T& operator [] (size_t pos) const constant
    {
        return elements[pos];
    }
    
    threadgroup T& operator [] (size_t pos) threadgroup
    {
        return elements[pos];
    }
    constexpr const threadgroup T& operator [] (size_t pos) const threadgroup
    {
        return elements[pos];
    }
};

struct Inner
{
    packed_float3 v[3];
};

struct S
{
    packed_float3 a;
    Inner in0;
    float c;
    packed_float3 b[2];
};

struct InB
{
    float i[1];
};

struct OutB
{
    float o[1];
};

constant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(64u, 1u, 1u);

static inline __attribute__((always_inline))
float f(thread const S& s)
{
    return (dot(float3(s.a), float3(s.in0.v[1])) + s.b[1][2u]) + s.c;
}

kernel void main0(device InB& inb [[buffer(0)]], device OutB& outb [[buffer(1)]], uint3 gl_LocalInvocationID [[thread_position_in_threadgroup]])
{
    threadgroup spvUnsafeArray<S, 64> sh;
    threadgroup spvUnsafeArray<float3, 64> plain;
    uint t = gl_LocalInvocationID.x;
    float x = inb.i[t];
    S loc;
    loc.a = float3(x, x + 1.0, x + 2.0);
    loc.in0.v[0] = float3(1.0, 2.0, 3.0) * x;
    loc.in0.v[1] = float3(x);
    loc.in0.v[2] = float3(3.0, 2.0, 1.0);
    loc.b[0] = float3(0.5 * x);
    loc.b[1] = float3(x, 2.0 * x, 3.0 * x);
    loc.c = x * 2.0;
    sh[t] = loc;
    plain[t] = float3(loc.a) + float3(1.0);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    S other = sh[(t + 1u) & 63u];
    S param = other;
    S param_1 = sh[t];
    float r = (((f(param) + f(param_1)) + ((threadgroup float*)&plain[(t + 3u) & 63u])[1u]) + ((threadgroup float*)&sh[(t + 5u) & 63u].in0.v[2])[0u]) + ((threadgroup float*)&sh[t].b[1])[1u];
    ((threadgroup float*)&sh[t].in0.v[1])[2u] += r;
    threadgroup_barrier(mem_flags::mem_threadgroup);
    outb.o[t] = r + ((threadgroup float*)&sh[(t + 2u) & 63u].in0.v[1])[2u];
}

