#pragma clang diagnostic ignored "-Wmissing-prototypes"
#pragma clang diagnostic ignored "-Wmissing-braces"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

template<typename T, size_t Num>
struct spvUnsafeArray
{
    T elements[Num ? Num : 1];
    
    thread T& operator [] (size_t pos) thread
    {
        return elements[pos];
    }
    constexpr const thread T& operator [] (size_t pos) const thread
    {
        return elements[pos];
    }
    
    device T& operator [] (size_t pos) device
    {
        return elements[pos];
    }
    constexpr const device T& operator [] (size_t pos) const device
    {
        return elements[pos];
    }
    
    constexpr const constant T& operator [] (size_t pos) const constant
    {
        return elements[pos];
    }
    
    threadgroup T& operator [] (size_t pos) threadgroup
    {
        return elements[pos];
    }
    constexpr const threadgroup T& operator [] (size_t pos) const threadgroup
    {
        return elements[pos];
    }
    
    object_data T& operator [] (size_t pos) object_data
    {
        return elements[pos];
    }
    constexpr const object_data T& operator [] (size_t pos) const object_data
    {
        return elements[pos];
    }
};

void spvSetMeshOutputsEXT(uint gl_LocalInvocationIndex, threadgroup uint2& spvMeshSizes, uint vertexCount, uint primitiveCount)
{
    if (gl_LocalInvocationIndex == 0)
    {
        spvMeshSizes.x = vertexCount;
        spvMeshSizes.y = primitiveCount;
    }
}

struct gl_MeshPerVertexEXT
{
    float4 gl_Position [[position]];
};

constant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(3u, 1u, 1u);

struct spvPerVertex
{
    float4 gl_Position [[position]];
    float4 corner [[user(locn0)]];
    float4 interpolated [[user(locn2)]];
    float2 _packed [[user(locn3_1)]];
};

struct spvPerPrimitive
{
    float4 spvCorner0_corner [[user(locn0_corner0)]];
    float4 spvCorner1_corner [[user(locn0_corner1)]];
    float4 spvCorner2_corner [[user(locn0_corner2)]];
    float2 spvCorner0_packed [[user(locn3_1_corner0)]];
    float2 spvCorner1_packed [[user(locn3_1_corner1)]];
    float2 spvCorner2_packed [[user(locn3_1_corner2)]];
};

using spvMesh_t = mesh<spvPerVertex, spvPerPrimitive, 3, 1, topology::triangle>;

static inline __attribute__((always_inline))
void _4(thread uint& gl_LocalInvocationIndex, threadgroup spvUnsafeArray<gl_MeshPerVertexEXT, 3>& gl_MeshVerticesEXT, threadgroup spvUnsafeArray<float4, 3>& corner, threadgroup spvUnsafeArray<float4, 3>& interpolated, threadgroup spvUnsafeArray<float2, 3>& _packed, threadgroup spvUnsafeArray<uint3, 1>& gl_PrimitiveTriangleIndicesEXT, threadgroup uint2& spvMeshSizes)
{
    spvSetMeshOutputsEXT(gl_LocalInvocationIndex, spvMeshSizes, 3u, 1u);
    float _25 = float(gl_LocalInvocationIndex);
    gl_MeshVerticesEXT[gl_LocalInvocationIndex].gl_Position = float4(_25, 0.0, 0.0, 1.0);
    corner[gl_LocalInvocationIndex] = float4(_25);
    interpolated[gl_LocalInvocationIndex] = float4(1.0);
    _packed[gl_LocalInvocationIndex] = float2(_25, 2.0);
    if (gl_LocalInvocationIndex == 0u)
    {
        gl_PrimitiveTriangleIndicesEXT[0] = uint3(2u, 0u, 1u);
    }
}

[[mesh]] void main0(uint gl_LocalInvocationIndex [[thread_index_in_threadgroup]], spvMesh_t spvMesh)
{
    threadgroup uint2 spvMeshSizes;
    threadgroup spvUnsafeArray<gl_MeshPerVertexEXT, 3> gl_MeshVerticesEXT;
    threadgroup spvUnsafeArray<float4, 3> corner;
    threadgroup spvUnsafeArray<float4, 3> interpolated;
    threadgroup spvUnsafeArray<float2, 3> _packed;
    threadgroup spvUnsafeArray<uint3, 1> gl_PrimitiveTriangleIndicesEXT;
    if (gl_LocalInvocationIndex == 0) spvMeshSizes.y = 0u;
    _4(gl_LocalInvocationIndex, gl_MeshVerticesEXT, corner, interpolated, _packed, gl_PrimitiveTriangleIndicesEXT, spvMeshSizes);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (spvMeshSizes.y == 0)
    {
        return;
    }
    spvMesh.set_primitive_count(spvMeshSizes.y);
    const uint spvThreadCount [[maybe_unused]] = (gl_WorkGroupSize.x * gl_WorkGroupSize.y * gl_WorkGroupSize.z);
    const uint spvVI = gl_LocalInvocationIndex;
    if (gl_LocalInvocationIndex < spvMeshSizes.x)
    {
        spvPerVertex spvV = {};
        spvV.gl_Position = gl_MeshVerticesEXT[spvVI].gl_Position;
        spvV.corner = corner[spvVI];
        spvV.interpolated = interpolated[spvVI];
        spvV._packed = _packed[spvVI];
        spvMesh.set_vertex(spvVI, spvV);
    }
    const uint spvPI = gl_LocalInvocationIndex;
    if (gl_LocalInvocationIndex < spvMeshSizes.y)
    {
        spvMesh.set_index(spvPI * 3u + 0u, gl_PrimitiveTriangleIndicesEXT[spvPI].x);
        spvMesh.set_index(spvPI * 3u + 1u, gl_PrimitiveTriangleIndicesEXT[spvPI].y);
        spvMesh.set_index(spvPI * 3u + 2u, gl_PrimitiveTriangleIndicesEXT[spvPI].z);
        spvPerPrimitive spvP = {};
        spvP.spvCorner0_corner = corner[gl_PrimitiveTriangleIndicesEXT[spvPI].x];
        spvP.spvCorner1_corner = corner[gl_PrimitiveTriangleIndicesEXT[spvPI].y];
        spvP.spvCorner2_corner = corner[gl_PrimitiveTriangleIndicesEXT[spvPI].z];
        spvP.spvCorner0_packed = _packed[gl_PrimitiveTriangleIndicesEXT[spvPI].x];
        spvP.spvCorner1_packed = _packed[gl_PrimitiveTriangleIndicesEXT[spvPI].y];
        spvP.spvCorner2_packed = _packed[gl_PrimitiveTriangleIndicesEXT[spvPI].z];
        spvMesh.set_primitive(spvPI, spvP);
    }
}

