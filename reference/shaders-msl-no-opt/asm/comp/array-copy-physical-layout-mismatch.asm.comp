struct SSBO
{
    float4 b[5];
    float4 c[5];
};

kernel void main0(device SSBO& _7 [[buffer(0)]])
{
    spvUnsafeArray<float, 5> a;
    spvArrayCopyFromDeviceToStack(a, _7.b);
    spvArrayCopyFromDeviceToStack(a, _7.b);
    spvArrayCopyFromStackToDevice(_7.b, a);
    spvArrayCopyFromStackToDevice(_7.c, a);
}

