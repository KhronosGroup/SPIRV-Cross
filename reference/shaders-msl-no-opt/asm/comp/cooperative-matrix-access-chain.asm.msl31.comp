#include <metal_stdlib>
#include <simd/simd.h>
#include <metal_simdgroup_matrix>

using namespace metal;

struct SSBO
{
    float data[1];
};

kernel void main0(device SSBO& ssbo [[buffer(0)]], uint gl_LocalInvocationIndex [[thread_index_in_threadgroup]])
{
    simdgroup_float8x8 _20;
    _20.thread_elements()[0u] = 1.0;
    _20.thread_elements()[1u] = 1.0;
    simdgroup_float8x8 mat = _20;
    mat.thread_elements()[gl_LocalInvocationIndex % 2u] = 2.0;
    mat.thread_elements()[1u] += 3.0;
    simdgroup_store(mat, &ssbo.data[0u], 8u);
}

