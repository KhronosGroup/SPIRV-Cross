{
    Block _m0[3];
};

kernel void main0(device SSBO& ssbo [[buffer(0)]])
{
    threadgroup uint2 _18[2];
    uint2 _27[2];
    spvArrayCopyFromDeviceToStack(_27, ssbo._m0[0u]._m1);
    spvArrayCopyFromStackToDevice(ssbo._m0[0u]._m0, _27);
    spvArrayCopyFromStackToDevice(ssbo._m0[0u]._m0, _27);
}

