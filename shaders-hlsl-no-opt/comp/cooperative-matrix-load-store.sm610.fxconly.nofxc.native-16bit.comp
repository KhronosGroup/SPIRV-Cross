#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) readonly buffer In16
{
	float16_t data[];
} in16;

layout(set = 0, binding = 1) readonly buffer In32
{
	float data[];
} in32;

layout(set = 0, binding = 2) buffer Out16
{
	uint pad;
	float16_t data[];
} out16;

layout(set = 0, binding = 3) buffer Out32
{
	float data[];
} out32;

void main()
{
	// Element offsets and strides count elements of the pointer's type.
	coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> a;
	coopMatLoad(a, in16.data, 256 * gl_WorkGroupID.x, 16, gl_CooperativeMatrixLayoutRowMajor);
	coopMatStore(a, out16.data, 256 * gl_WorkGroupID.x, 16, gl_CooperativeMatrixLayoutColumnMajor);

	// A float accumulator through float buffers, and a float16 matrix through a float buffer.
	coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> c;
	coopMatLoad(c, in32.data, 0, 16, gl_CooperativeMatrixLayoutColumnMajor);
	coopMatStore(c, out32.data, 512, 16, gl_CooperativeMatrixLayoutRowMajor);

	coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b;
	coopMatLoad(b, in32.data, 64, 8, gl_CooperativeMatrixLayoutRowMajor);
	coopMatStore(b, out16.data, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
}
